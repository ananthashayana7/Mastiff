{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "${TEAMS_APP_ID}",
  "packageName": "${TEAMS_PACKAGE_NAME}",
  "developer": {
    "name": "${DEVELOPER_NAME}",
    "websiteUrl": "${DEVELOPER_WEBSITE_URL}",
    "privacyUrl": "${DEVELOPER_PRIVACY_URL}",
    "termsOfUseUrl": "${DEVELOPER_TERMS_URL}"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "${APP_NAME}",
    "full": "${APP_NAME}"
  },
  "description": {
    "short": "${APP_SHORT_DESCRIPTION}",
    "full": "${APP_LONG_DESCRIPTION}"
  },
  "accentColor": "#E50914",
  "staticTabs": [
    {
      "entityId": "mastiff-home",
      "name": "${APP_NAME}",
      "contentUrl": "${APP_URL}",
      "websiteUrl": "${APP_URL}",
      "scopes": [
        "personal"
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "${APP_HOST}"
  ]
}