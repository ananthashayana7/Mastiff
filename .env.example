# Beagle AI Environment Variables
# For local Docker setup, copy this to .env

# Gemini API Key (Optional for now, required for AI features)
# Get your key at: https://aistudio.google.com/app/apikey
#
# Multiple API keys can be provided as a comma-separated list for
# automatic fallback when a key hits rate-limits or quota exhaustion.
# There is no hard limit in Mastiff; add more keys if you expect higher
# concurrency or want more quota headroom for many simultaneous users.
# Example: API_KEY=key1,key2,key3,key4,key5
API_KEY=your_gemini_api_key_here
